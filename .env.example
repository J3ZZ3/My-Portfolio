# Copy to .env for local development. Do not commit real values.

# Koji_Bot. Required for /api/chat. Missing key returns "Uplink offline."
GROQ_API_KEY=

# Leaderboard storage. Any one URL and matching token is enough.
# Vercel Upstash integration uses the KV_* names.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
